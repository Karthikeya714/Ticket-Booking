# Postgres connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ticketing?schema=public"

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Google Sign-In (customers only). Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials, with Authorized JavaScript origins set to
# your frontend URL(s) (e.g. http://localhost:5173 and your deployed Vercel URL). No redirect
# URI is needed since the frontend uses Google Identity Services' token flow, not a redirect.
# Paste the Client ID here AND as VITE_GOOGLE_CLIENT_ID in frontend/.env.example. Leave blank to
# disable Google Sign-In (email+password still works).
GOOGLE_CLIENT_ID=""

# Server
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Seat hold TTL, in minutes
HOLD_TTL_MINUTES=10

# Waitlist offer TTL, in minutes
WAITLIST_OFFER_TTL_MINUTES=30

# How often the expiry sweep cron runs, in seconds
EXPIRY_SWEEP_INTERVAL_SECONDS=15

# Base URL of the deployed frontend, used to build links in emails
FRONTEND_URL="http://localhost:5173"

# Brevo (https://www.brevo.com) transactional email API — not raw SMTP, because most free-tier
# PaaS hosts (Render included) block outbound SMTP ports entirely, which makes Nodemailer/Gmail
# impossible to use in production regardless of how correct the credentials are. Brevo sends over
# plain HTTPS instead, so it works the same locally and once deployed.
#
# Sign up free at https://www.brevo.com, then Settings -> SMTP & API -> API Keys -> generate one.
# EMAIL_FROM must be an address Brevo has verified under Senders (single-sender verification via
# a confirmation email — no domain/DNS setup required). Left blank by default: emails fall back
# to a console.log stub instead of attempting a real (and, with no key, doomed) send.
BREVO_API_KEY=""
EMAIL_FROM="Ticket Platform <no-reply@example.com>"
