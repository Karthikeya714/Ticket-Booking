# Used only by the test suite (vitest.setup.ts loads this before Prisma initializes), so tests
# never touch the dev database seeded for manual/UI testing.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ticketing_test?schema=public"
JWT_SECRET="test-secret"
JWT_EXPIRES_IN="1h"
PORT=4001
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
HOLD_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=30
EXPIRY_SWEEP_INTERVAL_SECONDS=15

# Deliberately blank: tests must never attempt a real network send. Without this, dotenv's
# "don't override an already-set var" default means an unset var here falls through to whatever
# backend/.env has — including a real Brevo key — and sendEmail() treats any non-empty key as
# "configured", triggering slow, noisy, real network attempts.
BREVO_API_KEY=""
